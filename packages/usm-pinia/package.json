{
  "name": "usm-pinia",
  "version": "4.9.0",
  "description": "Universal state model for Pinia",
  "main": "dist/index.cjs.js",
  "unpkg": "dist/index.umd.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/reactant/usm/issues"
  },
  "homepage": "https://github.com/reactant/usm#readme",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pnpm -w exec tsdown --filter usm-pinia"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactant/usm.git",
    "directory": "packages/usm-pinia"
  },
  "engines": {
    "node": ">=14.0"
  },
  "keywords": [
    "USM",
    "Pinia",
    "universal state model"
  ],
  "author": "unadlib",
  "license": "MIT",
  "dependencies": {
    "pinia": "^3.0.3"
  },
  "devDependencies": {
    "vue": "^3.5.22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/index.esm.js": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./dist/index.cjs.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./dist/index.umd.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "type": "commonjs"
}
