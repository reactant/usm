{
  "name": "usm-pinia",
  "version": "4.9.0",
  "description": "Universal state model for Pinia",
  "keywords": [
    "Pinia",
    "USM",
    "universal state model"
  ],
  "homepage": "https://github.com/reactant/usm#readme",
  "bugs": {
    "url": "https://github.com/reactant/usm/issues"
  },
  "license": "MIT",
  "author": "unadlib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactant/usm.git",
    "directory": "packages/usm-pinia"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "node": "./dist/index.node.mjs",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/index.esm.js": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./dist/index.cjs.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./dist/index.umd.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.umd.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "pnpm -w exec vitest run packages/usm-pinia/test",
    "build": "pnpm -w exec tsdown --filter usm-pinia"
  },
  "dependencies": {
    "pinia": "^3.0.3"
  },
  "devDependencies": {
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=14.0"
  }
}
