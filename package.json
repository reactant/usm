{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A concise & flexible state model for Redux/MobX/Vuex, etc.",
  "scripts": {
    "commit": "git-cz",
    "test:dev": "cross-env NODE_ENV=development jest --config ./scripts/jest/dev.config.json",
    "test:useES2015": "cross-env NODE_ENV=development jest --config ./scripts/jest/useES2015.config.json",
    "test": "pnpm test:dev",
    "check:type": "tsc --noEmit",
    "build": "tsdown",
    "clean": "node scripts/clean.mjs",
    "update:version": "lerna version --amend --no-git-tag-version",
    "publish": "lerna exec --no-private --no-bail -- npm publish",
    "test:package": "node scripts/check-packages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactant/usm.git"
  },
  "keywords": [],
  "authors": [
    "Michael Lin <unadlib@gmail.com> (https://github.com/unadlib)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reactant/usm/issues"
  },
  "homepage": "https://github.com/reactant/usm#readme",
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "commitizen": "^4.1.2",
    "cross-env": "^7.0.2",
    "eslint": "^8.36.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.19.1",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.4.0",
    "lerna": "^6.4.1",
    "prettier": "^2.0.5",
    "publint": "0.3.25",
    "rimraf": "^4.4.0",
    "ts-jest": "^29.2.5",
    "tsdown": "0.23.7",
    "tslib": "^2.8.1",
    "typedoc": "^0.26.11",
    "typedoc-plugin-markdown": "^4.2.10",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
