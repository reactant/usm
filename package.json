{
  "name": "usm-workspace",
  "version": "4.9.0",
  "private": true,
  "description": "A concise & flexible state model for Redux/MobX/Vuex, etc.",
  "keywords": [],
  "homepage": "https://github.com/reactant/usm#readme",
  "bugs": {
    "url": "https://github.com/reactant/usm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactant/usm.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "test:dev": "node scripts/test.mjs development",
    "test": "pnpm test:dev && pnpm test:prod",
    "check:type": "tsc --noEmit",
    "build": "tsdown",
    "clean": "node scripts/clean.mjs",
    "update:version": "pnpm release:version",
    "release:version": "node scripts/version.mjs",
    "test:package": "node scripts/check-packages.mjs",
    "test:prod": "node scripts/test.mjs production",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release:dry-run": "node scripts/release.mjs dry-run",
    "release:publish": "node scripts/release.mjs publish",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm check:type && pnpm test && pnpm test:package"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^24.19.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "~7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "authors": [
    "Michael Lin <unadlib@gmail.com> (https://github.com/unadlib)"
  ]
}
