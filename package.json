{
  "private": true,
  "description": "A concise & flexible state model for Redux/MobX/Vuex, etc.",
  "keywords": [],
  "homepage": "https://github.com/reactant/usm#readme",
  "bugs": {
    "url": "https://github.com/reactant/usm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactant/usm.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "commit": "git-cz",
    "test:dev": "node scripts/test.mjs development",
    "test": "pnpm test:dev && pnpm test:prod",
    "check:type": "tsc --noEmit",
    "build": "tsdown",
    "clean": "node scripts/clean.mjs",
    "update:version": "lerna version --amend --no-git-tag-version",
    "publish": "lerna exec --no-private --no-bail -- npm publish",
    "test:package": "node scripts/check-packages.mjs",
    "test:prod": "node scripts/test.mjs production",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "commitizen": "^4.1.2",
    "lerna": "^6.4.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "publint": "0.3.25",
    "rimraf": "^4.4.0",
    "tsdown": "0.23.7",
    "typescript": "~7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.21.0",
  "authors": [
    "Michael Lin <unadlib@gmail.com> (https://github.com/unadlib)"
  ]
}
